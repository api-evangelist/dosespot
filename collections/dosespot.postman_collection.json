              "path": ["patients", ":patientId", "prescriptions"],
              "variable": [
                { "key": "patientId", "value": "", "description": "The ID of the patient." }
              ]
            },
            "description": "Retrieve prescriptions and their statuses for a patient."
          },
          "response": []
        },
        {
          "name": "Create a prescription",
