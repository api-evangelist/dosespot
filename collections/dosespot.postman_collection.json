            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Subscription-Key", "value": "{{subscriptionKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"PharmacyId\": 0,\n  \"SetAsPrimary\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/patients/:patientId/pharmacies",
              "host": ["{{baseUrl}}"],
              "path": ["patients", ":patientId", "pharmacies"],
              "variable": [
                { "key": "patientId", "value": "", "description": "The ID of the patient." }
              ]
            },
            "description": "Save a pharmacy to a patient's preferred pharmacy list."
          },
          "response": []
        }
      ]
    },
